# ==============================================================================
# FVI Station 01 — Photovoltaic Final Visual Inspection Console
# Environment Configuration Template
# Copy this file to .env and fill in your facility's credentials.
# ==============================================================================

# Server Network Settings
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# ------------------------------------------------------------------------------
# 1. Company CMMS Authentication Database
# ------------------------------------------------------------------------------
# Mode: "external_rest" | "sqlite" | "external_sql"
CMMS_MODE=sqlite
CMMS_REST_LOGIN_URL=http://localhost:8000/api/v1/auth/login
CMMS_REST_ME_URL=http://localhost:8000/api/v1/auth/me
CMMS_REST_TIMEOUT_SEC=5

# Direct SQL Fallback (if SQL database is used for CMMS auth)
CMMS_SQL_TYPE=postgres
CMMS_HOST=localhost
CMMS_PORT=5432
CMMS_DATABASE=cmms
CMMS_USERNAME=postgres
CMMS_PASSWORD=your_cmms_password_here

# ------------------------------------------------------------------------------
# 2. EL Testing Camera PC Image Acquisition via FTP
# ------------------------------------------------------------------------------
FTP_ENABLED=false
FTP_HOST=192.168.1.150
FTP_PORT=21
FTP_USERNAME=el_tester
FTP_PASSWORD=your_ftp_password_here
FTP_REMOTE_DIR=/EL_Captures

# ------------------------------------------------------------------------------
# 3. Conveyor Arrival Sensor via MQTT
# ------------------------------------------------------------------------------
MQTT_ENABLED=false
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=factory/conveyor/fvi/station1/panel

# ------------------------------------------------------------------------------
# 4. Microsoft SQL Server Production Database (PL2)
# ------------------------------------------------------------------------------
MSSQL_ENABLED=false
MSSQL_SERVER=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=PL2
MSSQL_USER=Final_Inspection
MSSQL_PASSWORD=your_mssql_password_here
MSSQL_DRIVER=ODBC Driver 17 for SQL Server
MSSQL_TRUST_CERT=yes
MSSQL_TIMEOUT=3

# ------------------------------------------------------------------------------
# 5. Sun Simulator Flasher Database (Microsoft SQL Server / SQLExpress)
# ------------------------------------------------------------------------------
SUNSIM_ENABLED=false
SUNSIM_DRIVER=ODBC Driver 17 for SQL Server
SUNSIM_HOST=localhost
SUNSIM_PORT=1433
SUNSIM_DATABASE=SunSimulator_FVI
SUNSIM_USER=sunsim_reader
SUNSIM_PASSWORD=your_sunsim_password_here
SUNSIM_TIMEOUT=2

# ------------------------------------------------------------------------------
# 6. Hi-Pot Electrical Safety Tester Database (PostgreSQL)
# ------------------------------------------------------------------------------
HIPOT_ENABLED=false
HIPOT_HOST=localhost
HIPOT_PORT=5432
HIPOT_DATABASE=hipot_tests
HIPOT_USER=hipot_reader
HIPOT_PASSWORD=your_hipot_password_here
HIPOT_TIMEOUT=2
